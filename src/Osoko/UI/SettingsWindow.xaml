<Window x:Class="Osoko.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Osoko Settings"
        Width="760"
        Height="660"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#FF131319"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFontFamily}"
        Icon="pack://application:,,,/Osoko;component/Assets/osoko-256.png">

    <Border CornerRadius="8"
            Background="{StaticResource WindowSurfaceBrush}"
            BorderBrush="{StaticResource HairlineStrongBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <!-- =====================================================
                 Custom title bar (draggable)
                 ===================================================== -->
            <Grid Grid.Row="0" Margin="18,0,10,0" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Osoko;component/Assets/osoko-256.png"
                           Width="18"
                           Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Osoko Settings"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource IconButtonStyle}"
                        Content="&#xE8BB;"
                        FontSize="11"
                        ToolTip="Close"
                        Click="OnCancelClick" />
            </Grid>

            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{StaticResource DividerBrush}" />

            <!-- =====================================================
                 Tabs
                 ===================================================== -->
            <TabControl Grid.Row="1"
                        x:Name="Tabs"
                        Style="{StaticResource FluentTabControlStyle}"
                        Margin="18,14,10,0">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource FluentTabItemStyle}" />
                </TabControl.Resources>

                <!-- ===================== General ===================== -->
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Startup &amp; presence" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="How Osoko lives in the background and announces itself."
                                               Style="{StaticResource FieldHintStyle}" />
                                    <Border Style="{StaticResource DividerStyle}" />

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Launch at Windows startup" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Adds Osoko to your per-user Run key so it is always ready."
                                                       Style="{StaticResource FieldHintStyle}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Show the tray icon" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Quick access to settings, clearing the shelf and quitting."
                                                       Style="{StaticResource FieldHintStyle}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding ShowTrayIcon, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Play sound effects" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Soft cues when a capture lands, text is copied or an item is removed."
                                                       Style="{StaticResource FieldHintStyle}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding PlayShutterSound, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Capture behaviour" Style="{StaticResource SectionTitleStyle}" />
                                    <Border Style="{StaticResource DividerStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Copy new captures to the clipboard" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Every screenshot is immediately available for Ctrl+V."
                                                       Style="{StaticResource FieldHintStyle}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding AutoCopyToClipboard, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===================== Shelf & Stack ===================== -->
                <TabItem Header="Shelf &amp; Stack">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Stack size" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Osoko keeps the shelf light. Older captures fall off automatically, pinned ones stay."
                                               Style="{StaticResource FieldHintStyle}" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Maximum captures on the shelf" Style="{StaticResource FieldLabelStyle}" />
                                        <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MaxStackItems, StringFormat={}{0} items}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource AccentStrongBrush}" />
                                        </Border>
                                        <Slider Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,8,0,0"
                                                Style="{StaticResource FluentSliderStyle}"
                                                Minimum="1"
                                                Maximum="15"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding MaxStackItems, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Auto-collapse" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="After a moment of inactivity the shelf slides away, leaving a slim handle at the screen edge."
                                               Style="{StaticResource FieldHintStyle}" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Collapse when idle" Style="{StaticResource FieldLabelStyle}" />
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding AutoCollapseEnabled, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="0,14,0,0" IsEnabled="{Binding AutoCollapseEnabled}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Idle delay" Style="{StaticResource FieldLabelStyle}" />
                                        <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AutoCollapseDelaySeconds, StringFormat={}{0} s}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource AccentStrongBrush}" />
                                        </Border>
                                        <Slider Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,8,0,0"
                                                Style="{StaticResource FluentSliderStyle}"
                                                Minimum="3"
                                                Maximum="60"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding AutoCollapseDelaySeconds, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Consume after drag &amp; drop" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="Remove a capture from the shelf once you have dropped it into another app."
                                                   Style="{StaticResource FieldHintStyle}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding ConsumeOnDrop, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===================== Interception & Storage ===================== -->
                <TabItem Header="Interception &amp; Storage">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Interception" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Where Osoko looks for new screenshots."
                                               Style="{StaticResource FieldHintStyle}" />
                                    <Border Style="{StaticResource DividerStyle}" />

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Watch the clipboard" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Catches Snipping Tool captures (Win+Shift+S) the moment they are copied."
                                                       Style="{StaticResource FieldHintStyle}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding MonitorClipboard, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="16,0,0,18" IsEnabled="{Binding MonitorClipboard}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Also capture images copied from any app" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Browsers, chat apps, image editors — anything that puts a bitmap on the clipboard."
                                                       Style="{StaticResource FieldHintStyle}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding CaptureClipboardFromAnyApp, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Watch Pictures\Screenshots" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Picks up files saved by Snipping Tool and Win+PrintScreen."
                                                       Style="{StaticResource FieldHintStyle}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding MonitorScreenshotsFolder, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="16,0,0,0" IsEnabled="{Binding MonitorScreenshotsFolder}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Keep the Pictures folder clean" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Move intercepted files into Osoko's scratch cache instead of leaving copies behind."
                                                       Style="{StaticResource FieldHintStyle}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding CleanPicturesFolder, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Saving" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Where the one-click save button writes files."
                                               Style="{StaticResource FieldHintStyle}" />
                                    <Border Style="{StaticResource DividerStyle}" />

                                    <TextBlock Text="Default save location" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource ChipSurfaceBrush}"
                                                CornerRadius="8"
                                                Padding="10,7"
                                                BorderBrush="{StaticResource HairlineBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding SaveLocationPath}"
                                                       Style="{StaticResource MonoPathStyle}"
                                                       ToolTip="{Binding SaveLocationPath}" />
                                        </Border>
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Browse…"
                                                Padding="14,7"
                                                Click="OnBrowseFolderClick" />
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Ask for a file name when saving" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Opens the Windows save dialog instead of saving silently."
                                                       Style="{StaticResource FieldHintStyle}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding PromptToRenameOnSave, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Keyboard" Style="{StaticResource SectionTitleStyle}" />
                                    <Border Style="{StaticResource DividerStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Alt+Shift+S opens the Snipping Tool" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="One shortcut for capture, even when Snipping Tool is not running."
                                                       Style="{StaticResource FieldHintStyle}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding EnableGlobalHotkey, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- =====================================================
                 Footer
                 ===================================================== -->
            <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="18,0,16,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Text="Settings are stored in %LOCALAPPDATA%\Osoko\settings.json" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Restore defaults"
                                Margin="0,0,8,0"
                                Click="OnRestoreDefaultsClick" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Cancel"
                                Margin="0,0,8,0"
                                IsCancel="True"
                                Click="OnCancelClick" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Save"
                                IsDefault="True"
                                Click="OnSaveClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
