<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Osoko's dark "Fluent" palette.
        Colours are tuned for a translucent surface that floats above the desktop:
        deep charcoal backgrounds, hairline white borders and a single indigo accent.
    -->

    <!-- Surfaces -->
    <Color x:Key="ShelfSurfaceColor">#F21A1A22</Color>
    <Color x:Key="ShelfSurfaceColorAlt">#F2202029</Color>
    <Color x:Key="CardSurfaceColor">#FF23232C</Color>
    <Color x:Key="CardSurfaceHoverColor">#FF2B2B36</Color>
    <Color x:Key="ToolbarSurfaceColor">#E6101016</Color>
    <Color x:Key="ChipSurfaceColor">#B30B0B10</Color>

    <SolidColorBrush x:Key="ShelfSurfaceBrush" Color="{StaticResource ShelfSurfaceColor}" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="CardSurfaceHoverBrush" Color="{StaticResource CardSurfaceHoverColor}" />
    <SolidColorBrush x:Key="ToolbarSurfaceBrush" Color="{StaticResource ToolbarSurfaceColor}" />
    <SolidColorBrush x:Key="ChipSurfaceBrush" Color="{StaticResource ChipSurfaceColor}" />
    <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#FF16161C" />

    <LinearGradientBrush x:Key="ShelfGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F4222230" Offset="0" />
        <GradientStop Color="#F2181820" Offset="0.55" />
        <GradientStop Color="#F2121218" Offset="1" />
    </LinearGradientBrush>

    <!-- Accent -->
    <Color x:Key="AccentColor">#FF7C6CF7</Color>
    <Color x:Key="AccentColorAlt">#FF59C4F7</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#337C6CF7" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#FF9A8DFB" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8A7BFF" Offset="0" />
        <GradientStop Color="#FF5AA9F7" Offset="1" />
    </LinearGradientBrush>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF6F6FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA7A7B8" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF74748A" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFFFF" />

    <!-- Lines and feedback -->
    <SolidColorBrush x:Key="HairlineBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="HairlineStrongBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF6B7A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF69D6A0" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFFC46B" />

    <!-- Settings window surfaces -->
    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#F7141419" />
    <SolidColorBrush x:Key="SectionSurfaceBrush" Color="#FF1D1D25" />
    <SolidColorBrush x:Key="SectionBorderBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#FF3A3A47" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFF3F3F7" />

    <!-- Typography -->
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="GlyphFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
