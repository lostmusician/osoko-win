<Window x:Class="Osoko.UI.FloatingShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Osoko.Core"
        xmlns:controls="clr-namespace:Osoko.UI.Controls"
        xmlns:conv="clr-namespace:Osoko.UI.Converters"
        Title="Osoko"
        Width="368"
        Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display"
        MouseEnter="OnWindowMouseEnter"
        MouseLeave="OnWindowMouseLeave"
        MouseMove="OnWindowMouseMove"
        PreviewMouseDown="OnWindowPreviewMouseDown"
        Closing="OnWindowClosing">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" Threshold="0" />

        <DataTemplate DataType="{x:Type core:ScreenshotItem}">
            <controls:ScreenshotCard Margin="0,0,0,10" />
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True" Background="{x:Null}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="26" />
        </Grid.ColumnDefinitions>

        <!-- =========================================================
             Floating shelf
             ========================================================= -->
        <Border x:Name="ShelfPanel"
                Grid.Column="0"
                Margin="8,8,8,8"
                CornerRadius="20"
                BorderThickness="1"
                BorderBrush="{StaticResource HairlineStrongBrush}"
                Background="{StaticResource ShelfGradientBrush}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ShelfTransform" X="0" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.55" Color="#000000" />
            </Border.Effect>

            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="2,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                            <Image Source="pack://application:,,,/Osoko;component/Assets/osoko-256.png"
                                   Width="18"
                                   Height="18"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="Osoko"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Style="{StaticResource BadgeBorderStyle}"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding Count, Converter={StaticResource CountToVisibility}}">
                            <TextBlock Text="{Binding Count}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ClearButton"
                                Style="{StaticResource ShelfHeaderButtonStyle}"
                                Content="&#xE74D;"
                                ToolTip="Clear shelf"
                                Click="OnClearClick" />
                        <Button x:Name="SettingsButton"
                                Style="{StaticResource ShelfHeaderButtonStyle}"
                                Content="&#xE713;"
                                Margin="2,0,0,0"
                                ToolTip="Settings"
                                Click="OnSettingsClick" />
                    </StackPanel>
                </Grid>

                <!-- Divider -->
                <Border Grid.Row="1" Height="1" Margin="2,10,2,9" Background="{StaticResource DividerBrush}" />

                <!-- Stack -->
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="StackScroller"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  Focusable="False"
                                  CanContentScroll="False">
                        <ItemsControl x:Name="StackItems"
                                      ItemsSource="{Binding Items}"
                                      Margin="0,0,4,0"
                                      controls:ScreenshotCard.ActionRequested="OnCardActionRequested"
                                      controls:ScreenshotCard.DragStateChanged="OnCardDragStateChanged" />
                    </ScrollViewer>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="18,0"
                                Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="&#xE91B;"
                                   FontFamily="{StaticResource GlyphFontFamily}"
                                   FontSize="26"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="No captures yet"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource UiFontFamily}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="Press Win + Shift + S to snip something."
                                   Margin="0,5,0,0"
                                   Style="{StaticResource EmptyStateTextStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="3" Margin="2,9,2,0">
                    <TextBlock Text="Drag a card out to paste it anywhere"
                               Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock x:Name="HotkeyHint"
                               Text="Alt+Shift+S"
                               HorizontalAlignment="Right"
                               Style="{StaticResource CaptionTextStyle}"
                               Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <!-- =========================================================
             Edge grab handle
             ========================================================= -->
        <controls:GrabHandle x:Name="Handle"
                             Grid.Column="1"
                             Panel.ZIndex="5"
                             VerticalAlignment="Center"
                             Count="{Binding Count}"
                             ToggleRequested="OnHandleToggle"
                             MouseEnter="OnHandleMouseEnter" />

        <!-- =========================================================
             Toast
             ========================================================= -->
        <Border x:Name="ToastBanner"
                Grid.ColumnSpan="2"
                Panel.ZIndex="20"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,10,22"
                Padding="14,7"
                CornerRadius="10"
                Opacity="0"
                IsHitTestVisible="False"
                Background="{StaticResource ToolbarSurfaceBrush}"
                BorderBrush="{StaticResource HairlineStrongBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;"
                           FontFamily="{StaticResource GlyphFontFamily}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SuccessBrush}" />
                <TextBlock x:Name="ToastText"
                           Margin="7,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
