<UserControl x:Class="Osoko.UI.Controls.GrabHandle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="26"
             Height="124"
             Background="Transparent"
             Cursor="Hand"
             Focusable="False"
             SnapsToDevicePixels="True"
             MouseLeftButtonUp="OnMouseLeftButtonUp"
             MouseEnter="OnMouseEnter"
             MouseLeave="OnMouseLeave">
    <Grid>
        <Border x:Name="Pill"
                CornerRadius="10,0,0,10"
                BorderThickness="1,1,0,1"
                BorderBrush="{StaticResource HairlineStrongBrush}"
                Opacity="0.82">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F2303040" Offset="0" />
                    <GradientStop Color="#F21B1B25" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.45" Color="#000000" />
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="Chevron"
                           Text="&#xE76B;"
                           FontFamily="{StaticResource GlyphFontFamily}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <!-- Miniature "stack of cards" glyph -->
                <StackPanel Margin="0,7,0,0" HorizontalAlignment="Center">
                    <Border Width="11" Height="2" CornerRadius="1" Background="#B3FFFFFF" Margin="0,0,0,2" />
                    <Border Width="9" Height="2" CornerRadius="1" Background="#80FFFFFF" Margin="0,0,0,2" />
                    <Border Width="7" Height="2" CornerRadius="1" Background="#4DFFFFFF" />
                </StackPanel>

                <Border x:Name="CountBadge"
                        Margin="0,8,0,0"
                        MinWidth="18"
                        Height="18"
                        Padding="3,0"
                        CornerRadius="9"
                        Background="{StaticResource AccentGradientBrush}">
                    <TextBlock x:Name="CountText"
                               Text="0"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextOnAccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
