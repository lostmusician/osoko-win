<UserControl x:Class="Osoko.UI.Controls.ScreenshotCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Osoko.UI.Converters"
             x:Name="CardRoot"
             Height="150"
             Focusable="False"
             Background="Transparent"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             MouseEnter="OnCardMouseEnter"
             MouseLeave="OnCardMouseLeave"
             PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
             PreviewMouseMove="OnPreviewMouseMove"
             PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    </UserControl.Resources>

    <Grid>
        <Border x:Name="CardBorder"
                CornerRadius="14"
                BorderThickness="1"
                Background="{StaticResource CardSurfaceBrush}"
                ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>

                <!-- Thumbnail -->
                <Border Grid.Row="0" Background="{StaticResource PreviewSurfaceBrush}" ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding Thumbnail}"
                               Stretch="Uniform"
                               Margin="3"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderOptions.EdgeMode="Unspecified" />

                        <TextBlock Text="No preview available"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- Dimensions chip -->
                        <Border Style="{StaticResource BadgeBorderStyle}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="9,0,0,9">
                            <TextBlock Text="{Binding DimensionsLabel}"
                                       FontFamily="{StaticResource UiFontFamily}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>

                        <!-- Pinned badge -->
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="9"
                                Width="22"
                                Height="22"
                                CornerRadius="7"
                                Background="{StaticResource ChipSurfaceBrush}"
                                Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE718;"
                                       FontFamily="{StaticResource GlyphFontFamily}"
                                       FontSize="10"
                                       Foreground="{StaticResource AccentStrongBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!-- OCR busy overlay -->
                        <Border Background="#B3000000"
                                Visibility="{Binding IsRecognizing, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE895;"
                                           FontFamily="{StaticResource GlyphFontFamily}"
                                           FontSize="16"
                                           Foreground="{StaticResource AccentStrongBrush}"
                                           HorizontalAlignment="Center">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="SpinnerTransform" CenterX="8" CenterY="8" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="Reading text…"
                                           Margin="0,5,0,0"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Meta strip -->
                <Grid Grid.Row="1" Margin="11,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TimeLabel}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Border Width="1"
                                Height="9"
                                Margin="7,0"
                                Background="{StaticResource DividerBrush}" />
                        <TextBlock Text="{Binding SourceLabel}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AgeLabel}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </Grid>

                <!-- Hover toolbar -->
                <Border x:Name="ActionBar"
                        Grid.RowSpan="2"
                        Margin="8"
                        Padding="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        CornerRadius="9"
                        Background="{StaticResource ToolbarSurfaceBrush}"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="1"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CopyImageButton"
                                Style="{StaticResource CardActionButtonStyle}"
                                Content="&#xE8C8;"
                                ToolTip="Copy image"
                                Click="OnCopyImageClick" />
                        <Button x:Name="CopyTextButton"
                                Style="{StaticResource TextIconButtonStyle}"
                                Content="T"
                                ToolTip="Copy text (OCR)"
                                Click="OnCopyTextClick" />
                        <Button x:Name="PinButton"
                                Style="{StaticResource CardActionButtonStyle}"
                                Content="{Binding PinGlyph}"
                                ToolTip="{Binding PinTooltip}"
                                Click="OnPinClick" />
                        <Button x:Name="SaveButton"
                                Style="{StaticResource CardActionButtonStyle}"
                                Content="&#xE74E;"
                                ToolTip="Save image"
                                Click="OnSaveClick" />
                        <Button x:Name="RemoveButton"
                                Style="{StaticResource DangerCardActionButtonStyle}"
                                Content="&#xE74D;"
                                ToolTip="Remove from shelf"
                                Click="OnRemoveClick" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
