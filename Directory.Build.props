<Project>

  <!--
    Shared build settings for every project in the Osoko.Windows repository.
    Keeping these in one place guarantees that the application, the tests and
    any future tooling always compile against the same language level.
  -->
  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Allows `dotnet restore/build/test` to run on non-Windows CI agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>Osoko</Company>
    <Authors>Osoko</Authors>
    <Product>Osoko</Product>
    <Copyright>Copyright © 2025 Osoko</Copyright>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
